+#ifndef ISLAND_BRIDGE_H
+#define ISLAND_BRIDGE_H
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+
+static bool island_enabled() {
+    static const bool enabled = std::getenv("ISLAND_EVENTS") != NULL;
+    return enabled;
+}
+static std::string island_quote(const char *value) {
+    std::string out = "\"";
+    if (value) for (const unsigned char *p = (const unsigned char *) value; *p; ++p) {
+        switch (*p) {
+        case '"': out += "\\\""; break;
+        case '\\': out += "\\\\"; break;
+        case '\n': out += "\\n"; break;
+        case '\r': out += "\\r"; break;
+        case '\t': out += "\\t"; break;
+        default:
+            if (*p < 32) {
+                char hex[7]; std::snprintf(hex, sizeof(hex), "\\u%04x", (unsigned int) *p); out += hex;
+            } else out += (char) *p;
+        }
+    }
+    return out + "\"";
+}
+static void island_event(const std::string &payload) {
+    if (!island_enabled()) return;
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    std::string line = "@island " + payload + "\n";
+    std::fwrite(line.data(), 1, line.size(), stdout);
+    std::fflush(stdout);
+}
+static void island_activity(const char *kind) {
+    if (!island_enabled()) return;
+    static std::atomic<long long> last(0);
+    long long now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    long long previous = last.load();
+    if (now - previous >= 500 && last.compare_exchange_strong(previous, now))
+        island_event("{\"event\":\"activity\",\"kind\":" + island_quote(kind) + "}");
+}
+// Only fixed diagnostic stages leave the native process. Debug headers and keys
+// are never copied to the owning app, even while tracing the handshake.
+static void island_diagnostic(int level, const char *msg) {
+    const char *stage = NULL;
+    if (std::strncmp(msg, "Handling request ", 17) == 0 || std::strncmp(msg, "Unhandled Client Request:", 25) == 0) {
+        char method[32] = {}, path[96] = {};
+        if (std::sscanf(msg, "Handling request %31s with URL %95s", method, path) != 2)
+            std::sscanf(msg, "Unhandled Client Request: %31s %95s", method, path);
+        if (!std::strcmp(path, "/info")) stage = "info";
+        else if (!std::strcmp(path, "/pair-pin-start")) stage = "pin-request";
+        else if (!std::strcmp(path, "/pair-setup-pin")) stage = "pin-auth";
+        else if (!std::strcmp(path, "/pair-setup")) stage = "pair-setup";
+        else if (!std::strcmp(path, "/pair-verify")) stage = "pair-verify";
+        else if (!std::strcmp(path, "/fp-setup")) stage = "fairplay-setup";
+        else if (!std::strcmp(path, "/play")) stage = "hls-play";
+        else if (!std::strcmp(path, "/reverse")) stage = "hls-reverse";
+        else if (!std::strcmp(path, "/action")) stage = "hls-action";
+        else if (std::strstr(path, ".m3u8")) stage = "hls-playlist-request";
+        else if (!std::strcmp(method, "SETUP")) stage = "setup";
+        else if (!std::strcmp(method, "RECORD")) stage = "record";
+        else if (!std::strcmp(method, "TEARDOWN")) stage = "teardown";
+        else if (std::strncmp(msg, "Unhandled Client Request:", 25) == 0) stage = "unhandled-request";
+    } else if (std::strncmp(msg, "RTSP/1.0 ", 9) == 0 || std::strncmp(msg, "HTTP/1.1 ", 9) == 0) {
+        int code = std::atoi(msg + 9);
+        if (code >= 100 && code <= 599)
+            island_event("{\"event\":\"response\",\"code\":" + std::to_string(code) + "}");
+        return;
+    } else if (std::strstr(msg, "pair-pin-setup success")) stage = "pin-auth-success";
+    else if (std::strstr(msg, "client proof not validated")) stage = "pin-proof-rejected";
+    else if (std::strstr(msg, "client authentication failed")) stage = "pin-auth-rejected";
+    else if (std::strstr(msg, "signature is verified")) stage = "pair-verify-success";
+    else if (std::strstr(msg, "Incorrect pair-verify signature")) stage = "pair-signature-rejected";
+    else if (std::strstr(msg, "Invalid pair-verify data")) stage = "pair-verify-invalid";
+    else if (std::strstr(msg, "Client specified timingProtocol=")) stage = "unsupported-timing";
+    else if (std::strstr(msg, "Client specified AirPlay2")) stage = "unsupported-remote-protocol";
+    else if (std::strstr(msg, "Client did not supply timing_rport")) stage = "missing-timing-port";
+    else if (std::strstr(msg, "raop_rtp_mirror starting mirroring")) stage = "mirror-listener";
+    else if (std::strstr(msg, "raop_rtp_mirror accepting client")) stage = "mirror-client";
+    else if (std::strstr(msg, "raop_rtp starting audio")) stage = "audio-listener";
+    else if (std::strstr(msg, "first audio rtp sync")) stage = "audio-sync";
+    else if (std::strstr(msg, "Play request had no X-Apple-Session-ID")) stage = "hls-session-missing";
+    else if (std::strstr(msg, "Play request Content is not binary_plist")) stage = "hls-content-type-unsupported";
+    else if (std::strstr(msg, "Content-Location has unsupported form")) stage = "hls-location-unsupported";
+    else if (std::strstr(msg, "Could not find valid Plist Data for POST/play")) stage = "hls-play-invalid";
+    else if (std::strstr(msg, "POST /action: did not receive expected plist")) stage = "hls-action-invalid";
+    else if (std::strstr(msg, "playlist is not a valid M3U8")) stage = "hls-playlist-invalid";
+    else if (std::strstr(msg, "playlistInsert is not yet implemented")) stage = "hls-insert-unsupported";
+    else if (std::strstr(msg, "fcup_request failed")) stage = "hls-reverse-socket-error";
+    else if (std::strstr(msg, "fcup_request: send  error")) stage = "hls-reverse-send-error";
+    else if (std::strstr(msg, "httpd error in parsing")) stage = "http-parse-error";
+    else if (std::strstr(msg, "httpd error in sending data")) stage = "http-send-error";
+    else if (std::strstr(msg, "httpd: recv error")) stage = "http-receive-error";
+    else if (std::strstr(msg, "multiple TPPH connections")) stage = "hls-reverse-duplicate";
+    else if (std::strstr(msg, "requested master playlist") && std::strstr(msg, "not found")) stage = "hls-master-missing";
+    else if (std::strstr(msg, "requested media playlist") && std::strstr(msg, "rejected")) stage = "hls-media-invalid";
+    else if (std::strstr(msg, "requested media playlist") && std::strstr(msg, "not found")) stage = "hls-media-missing";
+    else if (std::strstr(msg, "Will use GStreamer playbin")) stage = "hls-pipeline-created";
+    else if (std::strstr(msg, "HLS buffering complete")) stage = "hls-buffer-ready";
+    else if (std::strstr(msg, "HLS buffering: pause")) stage = "hls-buffering";
+    else if (std::strncmp(msg, "Island video failure ", 21) == 0) {
+        char domain[16] = {}; int code = 0;
+        if (std::sscanf(msg + 21, "%15s %d", domain, &code) == 2 && code > 0 && code < 64 &&
+            (!std::strcmp(domain, "resource") || !std::strcmp(domain, "stream") ||
+             !std::strcmp(domain, "core") || !std::strcmp(domain, "library")))
+            island_event("{\"event\":\"phase\",\"stage\":" + island_quote((std::string("video-") + domain + "-error-" + std::to_string(code)).c_str()) + "}");
+        return;
+    }
+    else if (std::strstr(msg, "GStreamer error (video):")) {
+        if (std::strstr(msg, "TLS") || std::strstr(msg, "certificate")) stage = "video-tls-error";
+        else if (std::strstr(msg, "Missing") || std::strstr(msg, "missing") || std::strstr(msg, "No URI handler")) stage = "video-plugin-missing";
+        else if (std::strstr(msg, "Forbidden")) stage = "video-http-forbidden";
+        else if (std::strstr(msg, "Not Found")) stage = "video-http-not-found";
+        else if (std::strstr(msg, "resolve") || std::strstr(msg, "connect")) stage = "video-network-error";
+        else if (std::strstr(msg, "Output window was closed")) stage = "video-window-closed";
+        else stage = "video-pipeline-error";
+    }
+    else if (std::strstr(msg, "initializing socket failed") || std::strstr(msg, "initializing sockets failed")) stage = "socket-error";
+    else if (std::strstr(msg, "Error in decoding frame") || std::strstr(msg, "failed decryption")) stage = "decode-error";
+    else if (std::strstr(msg, "Accepted ") && std::strstr(msg, "client on socket")) stage = "client-socket";
+    else if (std::strstr(msg, "Disconnecting on software request")) stage = "server-disconnect";
+    else if (level <= 3) stage = "native-error";
+    if (stage) island_event("{\"event\":\"phase\",\"stage\":" + island_quote(stage) + "}");
+}
+#endif
