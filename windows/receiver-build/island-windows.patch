+static void hls_handle_buffering(video_renderer_t *target, gint percent) {
+    if (!target || percent < 0 || percent > 100) return;
+    gboolean was_buffering = target->buffering_level < 100;
+    target->buffering_level = percent;
+    hls_buffer_empty = (percent == 0);
+    hls_buffer_full = (percent == 100);
+    if (!was_buffering && percent < 100) {
+        logger_log(logger, LOGGER_INFO, "HLS buffering: pause at %d percent", percent);
+    } else if (was_buffering && percent == 100) {
+        logger_log(logger, LOGGER_INFO, "HLS buffering complete; requested playing=%d",
+                   g_atomic_int_get(&hls_requested_playing));
+    }
+    if (percent < 100) {
+        gst_element_set_state(target->pipeline, GST_STATE_PAUSED);
+    } else if (g_atomic_int_get(&hls_requested_playing)) {
+        gst_element_set_state(target->pipeline, GST_STATE_PLAYING);
+    }
+}
