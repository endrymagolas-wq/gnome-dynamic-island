+static GstElement *island_display_sink(void) {
+    if (!renderer || !renderer->pipeline) return NULL;
+    GstElement *sink = NULL;
+    if (hls_video) {
+        g_object_get(renderer->pipeline, "video-sink", &sink, NULL);
+    } else {
+        gchar *name = g_strdup_printf("d3d11videosink_%s", renderer->codec);
+        sink = gst_bin_get_by_name(GST_BIN(renderer->pipeline), name);
+        g_free(name);
+    }
+    return sink;
