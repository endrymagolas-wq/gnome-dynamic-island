+bool video_renderer_window_state(bool *is_fullscreen, bool *keep_aspect) {
+    GstElement *sink = island_display_sink();
+    if (!sink) return false;
+    bool supported = g_object_class_find_property(G_OBJECT_GET_CLASS(sink), "fullscreen") &&
+                     g_object_class_find_property(G_OBJECT_GET_CLASS(sink), "force-aspect-ratio");
+    if (supported) {
+        gboolean fs = FALSE, aspect = TRUE;
+        g_object_get(sink, "fullscreen", &fs, "force-aspect-ratio", &aspect, NULL);
+        *is_fullscreen = fs; *keep_aspect = aspect;
+    }
+    gst_object_unref(sink);
+    return supported;
+}
+bool video_renderer_set_window_state(bool is_fullscreen, bool keep_aspect) {
+    GstElement *sink = island_display_sink();
+    if (!sink) return false;
+    bool supported = g_object_class_find_property(G_OBJECT_GET_CLASS(sink), "fullscreen-toggle-mode") &&
+                     g_object_class_find_property(G_OBJECT_GET_CLASS(sink), "force-aspect-ratio");
+    if (supported)
+        g_object_set(sink, "fullscreen-toggle-mode", 6, "fullscreen", (gboolean)is_fullscreen,
+                     "force-aspect-ratio", (gboolean)keep_aspect, NULL);
+    gst_object_unref(sink);
+    return supported;
