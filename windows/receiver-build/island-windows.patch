+// Managed player controls run on the GStreamer main context.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef ISLAND_PLAYER_H
+#define ISLAND_PLAYER_H
+static gboolean island_player_poll(gpointer) {
+    bool fs = false, aspect = true;
+    bool window = video_renderer_window_state(&fs, &aspect);
+    bool hls = video_renderer_is_hls();
+    if (!window && !hls) return G_SOURCE_CONTINUE;
+    double duration = 0, position = -1, seek_start = 0, seek_duration = 0;
+    float rate = 0; bool empty = true, full = false;
+    if (hls) video_get_playback_info(&duration, &position, &seek_start, &seek_duration, &rate, &empty, &full);
+    char payload[512];
+    std::snprintf(payload, sizeof(payload),
+        "{\"event\":\"video-state\",\"hls\":%s,\"window\":%s,\"fullscreen\":%s,\"keepAspect\":%s,"
+        "\"position\":%.3f,\"duration\":%.3f,\"seekStart\":%.3f,\"seekDuration\":%.3f,"
+        "\"playing\":%s,\"buffer\":%d,\"bufferSeconds\":%d}",
+        hls ? "true" : "false", window ? "true" : "false", fs ? "true" : "false", aspect ? "true" : "false",
+        position, duration, seek_start, seek_duration, rate > 0 ? "true" : "false",
+        video_renderer_buffer_percent(), video_renderer_buffer_seconds());
+    island_event(payload);
+    return G_SOURCE_CONTINUE;
+}
+static gboolean island_player_command(gpointer data) {
+    const char *command = (const char *)data;
+    double position = 0; int fs = 0, aspect = 0, seconds = 0; char extra = 0;
+    if (video_renderer_is_hls()) {
+        if (!std::strcmp(command, "media-pause\n") || !std::strcmp(command, "media-pause\r\n")) {
+            video_renderer_pause();
+        }
+        else if (!std::strcmp(command, "media-play\n") || !std::strcmp(command, "media-play\r\n")) video_renderer_resume();
+        else if (std::sscanf(command, "media-seek %lf %c", &position, &extra) == 1 &&
+                 std::isfinite(position) && position >= 0 && position <= 86400) video_renderer_seek((float)position);
+    }
+    if (std::sscanf(command, "video-window %d %d %c", &fs, &aspect, &extra) == 2 &&
+        (fs == 0 || fs == 1) && (aspect == 0 || aspect == 1)) {
+        if (videosink == "d3d11videosink")
+            videosink_options = std::string(" fullscreen-toggle-mode=6 fullscreen=") + (fs ? "true" : "false") +
+                                " force-aspect-ratio=" + (aspect ? "true" : "false");
+        video_renderer_set_window_state(fs != 0, aspect != 0);
+    }
+    else if (std::sscanf(command, "video-buffer %d %c", &seconds, &extra) == 1 && seconds >= 2 && seconds <= 8)
+        video_renderer_set_buffer_seconds(seconds);
+    island_player_poll(NULL);
+    return G_SOURCE_REMOVE;
+}
+static void island_player_enqueue(const char *command) {
+    // Attaching an idle source always dispatches on the loop thread. Unlike
+    // g_main_context_invoke, it cannot execute on stdin during renderer restart.
+    GSource *source = g_idle_source_new();
+    g_source_set_callback(source, island_player_command, g_strdup(command), g_free);
+    g_source_attach(source, g_main_context_default());
+    g_source_unref(source);
+}
+#endif
